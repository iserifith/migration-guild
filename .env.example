# OpenAI-compatible runtime

# Default credential for the shipped OpenAI-compatible provider profile —
# set this unless .guild/config.yaml points you at a different provider.
OPENAI_API_KEY=
# Optional override of the provider endpoint (defaults to
# https://api.openai.com/v1; profiles in .guild/config.yaml may override):
# OPENAI_BASE_URL=https://api.openai.com/v1

# Agent harness — guildctl shells out to this for each phase. agent-shim.mjs
# adapts the GitHub Copilot CLI to run against an OpenAI-compatible endpoint
# (BYOK). Path is relative to the workspace root, which is guildctl's spawn cwd.
AGENT_CMD=agent-shim.mjs
# Pin the Copilot CLI entry only if auto-detection fails:
# COPILOT_CLI_ENTRY=C:\Users\<you>\AppData\Local\copilot\pkg\win32-x64\<ver>\index.js

# Alternative runtimes
OPENROUTER_API_KEY=
# Optional local OpenAI-compatible endpoint
# OPENAI_BASE_URL=http://localhost:1234/v1
